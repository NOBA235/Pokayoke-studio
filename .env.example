# Firebase Web App Configuration (Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Firebase App Check (ReCaptcha Enterprise or V3 Site Key)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Optional: set to "true" or an explicit debug UUID on localhost for Firebase App Check Debug Provider
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Optional Model Overrides
VITE_CLOUD_GEMINI_MODEL=gemini-2.5-flash
